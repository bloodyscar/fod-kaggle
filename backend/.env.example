# Copy to backend/.env and adjust. Never commit the real .env.

DATABASE_URL=mysql+pymysql://root:PASSWORD@127.0.0.1:3306/fod_sentry?charset=utf8mb4
SQL_ECHO=false

# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=8
COOKIE_SECURE=false

ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

COOLDOWN_SECONDS=10
SAVE_SNAPSHOTS=true

# Open-Meteo — no API key required.
WEATHER_LAT=-3.3667
WEATHER_LON=135.4833
WEATHER_TIMEZONE=Asia/Jayapura
WEATHER_TTL_SECONDS=600

# Dataset gallery — FOD-A frames in VOC2007/JPEGImages at the project root.
# The indexer labels sample frames with best.onnx; it stops once every class has
# DATASET_PER_CLASS samples, or after DATASET_SCAN_LIMIT frames.
DATASET_PER_CLASS=20
DATASET_SCAN_LIMIT=6000
DATASET_MIN_CONF=0.45
